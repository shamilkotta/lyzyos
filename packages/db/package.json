{
  "name": "@lyzyos/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./store": "./src/store.ts",
    "./schema": "./src/project.schema.ts",
    "./auth-schema": "./src/auth.schema.ts",
    "./client": "./src/client.ts",
    "./r2": "./src/r2.ts",
    "./sync": "./src/sync.ts",
    "./users": "./src/users.ts"
  },
  "scripts": {
    "lint": "oxlint .",
    "generate": "drizzle-kit generate",
    "migrate": "wrangler d1 migrations apply lyzy --local --persist-to ../../.wrangler/state --config ../../sync/wrangler.jsonc",
    "migrate:remote": "wrangler d1 migrations apply lyzy --remote --config ../../sync/wrangler.jsonc",
    "migrate:list": "wrangler d1 migrations list lyzy --local --persist-to ../../.wrangler/state --config ../../sync/wrangler.jsonc",
    "migrate:list:remote": "wrangler d1 migrations list lyzy --remote --config ../../sync/wrangler.jsonc",
    "reset": "rm -rf ../../.wrangler/state/v3/d1 ../../sync/.wrangler/state/v3/d1 ../../agent/.wrangler/state/v3/d1 ../../web/.wrangler/state/v3/d1 && CI=1 wrangler d1 migrations apply lyzy --local --persist-to ../../.wrangler/state --config ../../sync/wrangler.jsonc",
    "auth:generate": "pnpm --filter @lyzyos/auth auth:generate",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261004.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3",
    "wrangler": "^4.147.0"
  }
}
