{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "lyzy-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lyzy",
      "database_id": "00000000-0000-0000-0000-000000000001",
    },
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "lyzy-files",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKSPACE_SYNC",
        "class_name": "WorkspaceSync",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1-workspace-sync",
      "new_sqlite_classes": ["WorkspaceSync"],
    },
  ],
}
