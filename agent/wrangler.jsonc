{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lyzy",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
  "dev": {
    "port": 8787,
  },
  "vars": {},
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  "browser": {
    "binding": "BROWSER",
  },
  "worker_loaders": [
    {
      "binding": "LOADER",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lyzy",
      "database_id": "5bd99c72-6251-43d3-bf51-38d1c93f86c9",
      "migrations_dir": "../packages/db/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "lyzy-files",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "AGENT", "class_name": "Lyzy" },
      {
        "name": "WORKSPACE_SYNC",
        "class_name": "WorkspaceSync",
        "script_name": "lyzy-sync",
      },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Lyzy"] }],
}
